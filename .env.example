# Copy to .env and fill in. Every value has a working default in volley/config.py,
# so .env is only needed to point the app at a different sheet or team.

# docs.google.com/spreadsheets/d/<THIS PART>/edit
VOLLEY_SPREADSHEET_ID=

# From your Profixio team URL:
# profixio.com/app/leagueid<LEAGUE_ID>/teams/<TEAM_ID>?k=<KEY>
VOLLEY_PROFIXIO_LEAGUE_ID=
VOLLEY_PROFIXIO_TEAM_ID=
VOLLEY_PROFIXIO_KEY=

# Exactly as Profixio spells it - used to tell our rows from the opponent's.
VOLLEY_TEAM_NAME=

# Optional: club crest shown in the sidebar and header.
VOLLEY_LOGO=

# Optional: path to a service-account JSON key. If set (or if
# ./service_account.json exists) it is used before anything else - share the
# spreadsheet with the account's email first.
VOLLEY_SERVICE_ACCOUNT=
